# Copy this file to .env and fill in your values
# Never commit .env to git

# AWS IAM Identity Center
IDENTITY_STORE_ID=d-xxxxxxxxxx
SSO_INSTANCE_ARN=arn:aws:sso:::instance/ssoins-xxxxxxxxxxxxxxxxx
AWS_REGION=eu-central-1

# RDS PostgreSQL — get endpoint from: terraform output rds_endpoint
DB_HOST=innovatech-postgres.xxxxxxxxxx.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=innovatech
DB_USER=innovatech_admin
DB_PASS=replace-with-strong-password
